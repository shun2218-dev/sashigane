{
  "name": "sashigane",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "scales": "node scripts/metrics/generate-scales.mjs",
    "verify:coverage": "node scripts/metrics/verify-coverage.mjs",
    "metrics": "node scripts/metrics/pr-metrics.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false packages/tokens packages/ui apps/docs",
    "check:tokens-isolation": "node scripts/check-tokens-isolation.mjs",
    "check:no-build-output": "node scripts/check-no-build-output.mjs",
    "check:docs-scales": "node scripts/check-docs-scales.mjs",
    "check:docs-refs": "node scripts/check-docs-refs.mjs",
    "build:tokens": "pnpm --filter @sashigane/tokens build",
    "docs:data": "node scripts/build-component-docs.mjs",
    "check:tokens-standalone": "node scripts/check-tokens-standalone.mjs",
    "check:tailwind-adapter": "node scripts/check-tailwind-adapter.mjs",
    "check:scss": "node scripts/check-scss-compiles.mjs",
    "check:token-usage": "node scripts/check-token-usage.mjs",
    "check:sample-page": "node scripts/check-sample-page.mjs",
    "check:token-values": "node scripts/check-token-values.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:readme-freshness": "node scripts/check-readme-freshness.mjs",
    "check:token-types": "node scripts/check-token-types.mjs",
    "check:output-header": "node scripts/check-output-header.mjs",
    "check:component-classes": "node scripts/check-component-classes.mjs",
    "check:component-examples": "node scripts/check-component-examples.mjs",
    "check:public-language": "node scripts/check-public-language.mjs",
    "check:docs-search": "node scripts/check-docs-search.mjs",
    "check:docs-llms": "node scripts/check-docs-llms.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "check:registry": "node scripts/check-registry.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.8",
    "sass": "^1.103.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  }
}
