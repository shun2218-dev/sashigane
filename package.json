{
  "name": "sashigane",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "scales": "node scripts/metrics/generate-scales.mjs",
    "verify:coverage": "node scripts/metrics/verify-coverage.mjs",
    "check:lessons": "node scripts/check-lessons-sync.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false packages/tokens",
    "check:tokens-isolation": "node scripts/check-tokens-isolation.mjs",
    "check:no-build-output": "node scripts/check-no-build-output.mjs",
    "check:docs-scales": "node scripts/check-docs-scales.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
