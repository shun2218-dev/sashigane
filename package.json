{
  "name": "sashigane",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "scales": "node scripts/metrics/generate-scales.mjs",
    "verify:coverage": "node scripts/metrics/verify-coverage.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false packages/tokens apps/docs",
    "check:tokens-isolation": "node scripts/check-tokens-isolation.mjs",
    "check:no-build-output": "node scripts/check-no-build-output.mjs",
    "check:docs-scales": "node scripts/check-docs-scales.mjs",
    "build:tokens": "pnpm --filter @sashigane/tokens build",
    "check:tokens-standalone": "node scripts/check-tokens-standalone.mjs",
    "check:tailwind-adapter": "node scripts/check-tailwind-adapter.mjs",
    "check:scss": "node scripts/check-scss-compiles.mjs",
    "check:token-usage": "node scripts/check-token-usage.mjs",
    "check:token-values": "node scripts/check-token-values.mjs",
    "check:token-types": "node scripts/check-token-types.mjs",
    "check:output-header": "node scripts/check-output-header.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "sass": "^1.103.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
