#!/bin/sh
# main と develop への直接 push を機械的に防ぐ。
#
# ブランチの役割:
#   main    リリース線。ここにあるものが公開される
#   develop 統合線。作業ブランチはここから切り、ここへ PR を出す
#
# 変更は必ず Issue → branch → PR を通す。人間・AIエージェントを問わず、
# 速度を理由にこの手順を飛ばさないための強制。
#
# このフックは手元だけの防御である。clone した別環境や GitHub の Web UI からの
# 操作は止められない。そのため GitHub 側の branch protection と併用する。
# 詳細は docs/branching.md。
#
# 意図的に迂回する必要がある場合のみ:
#   SASHIGANE_ALLOW_PROTECTED_PUSH=1 git push
# 迂回した場合は docs/agent-failures.md に理由を記録すること。

protected_branches="main develop"

while read -r local_ref local_sha remote_ref remote_sha; do
  for branch in $protected_branches; do
    if [ "$remote_ref" = "refs/heads/$branch" ]; then
      if [ "$SASHIGANE_ALLOW_PROTECTED_PUSH" = "1" ]; then
        echo "pre-push: SASHIGANE_ALLOW_PROTECTED_PUSH=1 のため $branch への push を許可します" >&2
        exit 0
      fi
      echo "pre-push: $branch への直接 push は禁止されています。" >&2
      echo "          作業ブランチを develop から切って PR を出してください。" >&2
      echo "          リリースは develop → main の PR で行います（docs/branching.md）。" >&2
      exit 1
    fi
  done
done

exit 0
