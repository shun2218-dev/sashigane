{
  "name": "@sashigane/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:tokens": "pnpm --filter @sashigane/tokens build && cp ../../packages/tokens/dist/tokens.css public/tokens.css",
    "dev": "pnpm prepare:tokens && next dev",
    "build": "pnpm prepare:tokens && next build",
    "start": "next start"
  },
  "dependencies": {
    "@sashigane/tokens": "workspace:*",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.4",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "4.3.3"
  }
}
